# SnapBrand Cloud & Local Environment Configuration Template

# Server Port Settings
PORT=5000
NODE_ENV=development

# Database & Cache Configurations
DATABASE_URL=postgresql://snapuser:snappassword@localhost:5432/snapbrand
REDIS_URL=redis://localhost:6379

# DevSecOps & Security Authentication
JWT_SECRET=replace_with_64_byte_cryptographic_secret
API_SECRET_SALT=snapbrand_devsecops_salt_2026

# Amazon Web Services Multi-AZ Deployment Variables
AWS_REGION=us-east-1
AWS_ROLE_ARN=arn:aws:iam::123456789012:role/SnapBrandDeploymentRole
ECR_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com
ALB_DNS_URL=http://snapbrand-alb-123456789.us-east-1.elb.amazonaws.com
